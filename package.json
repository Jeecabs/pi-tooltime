{
  "name": "pi-tooltime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "Pi tool-time analytics and prompt coaching.",
  "author": "Lachlan Jacobs <lachlan.jacobs@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeecabs/pi-tooltime.git"
  },
  "homepage": "https://jeecabs.github.io/pi-tooltime/",
  "bugs": {
    "url": "https://github.com/Jeecabs/pi-tooltime/issues"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./extension": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tool-analytics",
    "agent-evals"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsgo -p tsconfig.build.json && node scripts/rewrite-declarations.mjs",
    "check": "tsgo --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "prepack": "npm run build",
    "core:contract": "node scripts/verify-core-api.mjs",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --entrypoints . ./extension --quiet",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:metadata": "node scripts/verify-release-metadata.mjs",
    "release:ready": "node scripts/verify-release-metadata.mjs --require-license && pnpm verify",
    "verify": "pnpm check && pnpm release:metadata && pnpm test && pnpm build && pnpm core:contract && pnpm lint:package && pnpm pack:check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^22.20.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "publint": "^0.3.23"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.10.0"
    }
  }
}
